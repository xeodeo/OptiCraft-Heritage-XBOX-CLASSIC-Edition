+        MC_LOG_INFO("xbox", "video: image asks 720p=%d 1080i=%d, dashboard flags=%08lx -> %dx%d%s\n",
+                    asks720p ? 1 : 0, asks1080i ? 1 : 0, static_cast<unsigned long>(flags),
+                    s_mode.width, s_mode.height, s_mode.interlaced ? "i" : "");
     }
