# Run at every Xbox build (cmake -P): writes the build stamp shown in the log and
# on the main menu, so the console tells which XBE it is running. __DATE__ in
# main_xbox.cpp only changes when that one file is recompiled.
#   -DOUT=<file.cpp> -DLABEL=<1.2.5|1.5.2> -DSOURCE_DIR=<repo>
string(TIMESTAMP stamp_time "%d-%m %H:%M")
set(stamp_hash "")
find_program(stamp_git git)
if(stamp_git)
    execute_process(COMMAND "${stamp_git}" -C "${SOURCE_DIR}" rev-parse --short HEAD
                    OUTPUT_VARIABLE stamp_hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${stamp_git}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE stamp_dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(stamp_dirty)
        set(stamp_hash "${stamp_hash}+")
    endif()
endif()
file(WRITE "${OUT}"
    "// Generated by cmake/xbox_build_stamp.cmake at every build; do not edit.\n"
    "extern \"C\" const char *xboxBuildStamp() { return \"${LABEL} ${stamp_time} ${stamp_hash}\"; }\n")
