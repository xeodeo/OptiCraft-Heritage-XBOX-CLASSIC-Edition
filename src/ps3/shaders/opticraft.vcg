// OptiCraft vertex program: the GL 1.x fixed-function transform the game
// expects (see RenderAPI_RSX_PS3.cpp), plus the fog factor.
//
// Matrices arrive in GL column-major layout. Cg reads a float4x4 uniform row by
// row, so it holds the transpose, and mul(v, M) is GL's M * v.
//
// lightConst: xy = constant lightmap coordinate, z = 1 to use it instead of the
// per-vertex one (entity/tile-entity/held-item light), w = 1 for radial fog
// distance (GL_EYE_RADIAL_NV) instead of eye-plane |z|.
//
// Fog is evaluated here, per vertex, and handed to the fragment program with
// its colour: fragment-program constants live inside the microcode and did not
// reach the shader (everything came out fog-coloured), vertex constants do.
// Mode is selected by weights instead of branches:
//   factor = saturate(linear*fogWeights.x + exp*fogWeights.y + exp2*fogWeights.z + fogWeights.w)
//   fogParams: x = -1/(end-start), y = end/(end-start), z = density. Fog off = weights (0, 0, 0, 1).
// alphaTest is passed through for the same reason: x = 1 when GL_ALPHA_TEST is on, y = the
// reference; the fragment program discards alpha <= reference (GL_GREATER, all Minecraft uses).
// z = 1 applies the Legacy Look gamma in the fragment program.
// colorConst: the current GL colour (0..1) for a recorded mesh that takes it
// (entity models, sky): drawn straight from RSX memory with this instead of
// being copied with the colour patched in. x < 0 = use the per-vertex colour.
void main(float4 position : POSITION,
          float4 color : COLOR,
          float2 uv : TEXCOORD0,
          float2 lightUv : TEXCOORD1,
          uniform float4x4 modelViewProjection,
          uniform float4x4 modelView,
          uniform float4x4 textureMatrix,
          uniform float4 lightConst,
          uniform float4 fogColor,
          uniform float4 fogParams,
          uniform float4 fogWeights,
          uniform float4 alphaTest,
          uniform float4 colorConst,
          out float4 oPosition : POSITION,
          out float4 oColor : COLOR,
          out float4 oUv : TEXCOORD0,
          out float4 oFog : TEXCOORD1,
          out float4 oAlphaTest : TEXCOORD2)
{
    oPosition = mul(position, modelViewProjection);
    float4 eye = mul(position, modelView);
    float distance = lerp(abs(eye.z), length(eye.xyz), lightConst.w);
    float linearFactor = distance * fogParams.x + fogParams.y;
    float d = fogParams.z * distance;
    float factor = saturate(linearFactor * fogWeights.x + exp(-d) * fogWeights.y +
                            exp(-d * d) * fogWeights.z + fogWeights.w);
    oFog = float4(fogColor.rgb, factor);
    float2 transformedUv = mul(float4(uv, 0.0f, 1.0f), textureMatrix).xy;
    oUv = float4(transformedUv, lerp(lightUv, lightConst.xy, lightConst.z));
    oColor = colorConst.x >= 0.0f ? colorConst : color;
    oAlphaTest = alphaTest;
}
