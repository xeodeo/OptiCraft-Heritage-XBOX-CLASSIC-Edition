// OptiCraft fragment program: GL_MODULATE of texture unit 0 (the bound
// texture), unit 1 (the lightmap) and the vertex color, then the fog the vertex
// program computed (fog.rgb = colour, fog.a = factor, 1 = no fog).
//
// Units that the game leaves disabled get a 1x1 white texture, so one program
// covers every combination. No uniforms on purpose: see opticraft.vcg.
float4 main(float4 color : COLOR,
            float4 uv : TEXCOORD0,
            float4 fog : TEXCOORD1,
            uniform sampler2D texture0 : TEXUNIT0,
            uniform sampler2D lightmap : TEXUNIT1) : COLOR
{
    float4 result = color * tex2D(texture0, uv.xy) * tex2D(lightmap, uv.zw);
    result.rgb = lerp(fog.rgb, result.rgb, fog.a);
    return result;
}
